-- LOGIC CHẠY NGẦM (FARM KẸO + AUTO SERVER HOP)
-- ==========================================
local function GetClosestCandy()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local closest, shortest = nil, math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("candy") or name:find("halloween") or name:find("treat") then
                local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                if part and part.Parent then
                    local dist = (root.Position - part.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = part
                    end
                end
            end
        end
    end
    return closest
end

task.spawn(function()
    local emptyChecks = 0
    while task.wait(0.3) do
        if getgenv().TSB.AutoFarmCandy then
            pcall(function()
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local candy = GetClosestCandy()
                if root and candy then
                    emptyChecks = 0
                    if getgenv().TSB.FarmMethod == "Instant" then
                        root.CFrame = candy.CFrame + Vector3.new(0, 2, 0)
                    else
                        local dist = (root.Position - candy.Position).Magnitude
                        local tween = TweenService:Create(root, TweenInfo.new(dist / getgenv().TSB.TweenSpeed, Enum.EasingStyle.Linear), {CFrame = candy.CFrame + Vector3.new(0, 2, 0)})
                        tween:Play()
                        tween.Completed:Wait()
                    end
                    local prompt = candy:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and fireproximityprompt then
                        fireproximityprompt(prompt)
                    end
                else
                    -- Nếu bật Auto Server Hop và quét 5 lần (~1.5s) không thấy kẹo nào thì đổi server
                    if getgenv().TSB.AutoHopWhenEmpty then
                        emptyChecks = emptyChecks + 1
                        if emptyChecks >= 5 then
                            emptyChecks = 0
                            ServerHop()
                            task.wait(5)
                        end
                    end
                end
            end)
        end
    end
end)

